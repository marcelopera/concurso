{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tópico de edital — contrato v1",
  "type": "object",
  "required": ["documento_id", "texto_original", "paginas_pdf", "regioes_fonte", "status_extracao", "alertas", "metodo_extracao", "agente"],
  "properties": {
    "documento_id": {"type": "string", "minLength": 1},
    "texto_original": {"type": "string", "minLength": 1},
    "paginas_pdf": {"type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 1, "uniqueItems": true},
    "regioes_fonte": {"type": "array", "items": {"type": "object", "required": ["pagina", "bbox"], "properties": {"pagina": {"type": "integer", "minimum": 1}, "bbox": {"type": "array", "items": {"type": "number", "minimum": 0}, "minItems": 4, "maxItems": 4}}}},
    "status_extracao": {"enum": ["extraido", "precisa_revisao", "incompleto"]},
    "alertas": {"type": "array", "items": {"type": "string"}},
    "metodo_extracao": {"type": "string", "minLength": 1},
    "agente": {"type": "string", "minLength": 1}
  }
}
